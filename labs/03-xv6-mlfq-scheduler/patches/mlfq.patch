diff --git a/user/mlfqtest.c b/user/mlfqtest.c
new file mode 100644
index 0000000..cd971b3
--- /dev/null
+++ b/user/mlfqtest.c
@@ -0,0 +1,78 @@
+#include "kernel/types.h"
+#include "kernel/stat.h"
+#include "user/user.h"
+
+static void
+busy_work(int iterations)
+{
+  volatile int value = 0;
+  for(int i = 0; i < iterations; i++)
+    value += i;
+}
+
+static void
+cpu_worker(int id, int rounds)
+{
+  printf("[cpu-%d] start pid=%d rounds=%d\n", id, getpid(), rounds);
+  for(int i = 0; i < rounds; i++)
+    busy_work(20000);
+  printf("[cpu-%d] complete pid=%d\n", id, getpid());
+  exit(0);
+}
+
+static void
+io_worker(int id, int rounds)
+{
+  printf("[io-%d] start pid=%d rounds=%d\n", id, getpid(), rounds);
+  for(int i = 0; i < rounds; i++) {
+    busy_work(1000);
+    pause(3);
+  }
+  printf("[io-%d] complete pid=%d\n", id, getpid());
+  exit(0);
+}
+
+int
+main(int argc, char *argv[])
+{
+  int stress = argc > 1 && strcmp(argv[1], "stress") == 0;
+  int cpu_rounds = stress ? 800 : 80;
+  int io_rounds = stress ? 100 : 12;
+  int children = 0;
+
+  printf("MLFQ mixed-workload test (%s mode)\n", stress ? "stress" : "fast");
+
+  int pid = fork();
+  if(pid == 0)
+    cpu_worker(1, cpu_rounds);
+  if(pid > 0)
+    children++;
+
+  pid = fork();
+  if(pid == 0)
+    io_worker(1, io_rounds);
+  if(pid > 0)
+    children++;
+
+  pid = fork();
+  if(pid == 0)
+    cpu_worker(2, cpu_rounds + cpu_rounds / 2);
+  if(pid > 0)
+    children++;
+
+  pid = fork();
+  if(pid == 0)
+    io_worker(2, io_rounds + io_rounds / 2);
+  if(pid > 0)
+    children++;
+
+  for(int completed = 0; completed < children; completed++) {
+    int status = 0;
+    int child = wait(&status);
+    printf("[parent] pid=%d status=%d (%d/%d)\n",
+           child, status, completed + 1, children);
+  }
+
+  printf("MLFQ test complete: %d children finished\n", children);
+  exit(children == 4 ? 0 : 1);
+}
