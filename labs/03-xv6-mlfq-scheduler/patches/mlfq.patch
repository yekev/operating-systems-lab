@@ -10,6 +10,56 @@ struct cpu cpus[NCPU];
 
 struct proc proc[NPROC];
 
+
+#define MLFQ_LEVELS 3
+#define PROMOTION_INTERVAL 100
+
+static const int time_slices[MLFQ_LEVELS] = {3, 6, 12};
+static struct spinlock mlfq_lock;
+static int last_scheduled[MLFQ_LEVELS] = {-1, -1, -1};
+static uint64 last_promotion_tick;
+
+extern uint ticks;
+
+static int
+time_slice_for(int queue_level)
+{
+  if(queue_level < 0 || queue_level >= MLFQ_LEVELS)
+    return time_slices[MLFQ_LEVELS - 1];
+  return time_slices[queue_level];
+}
+
+static uint64
+current_ticks(void)
+{
+  uint64 now;
+
+  acquire(&tickslock);
+  now = ticks;
+  release(&tickslock);
+  return now;
+}
+
+static void
+promote_processes(void)
+{
+  struct proc *p;
+
+  for(p = proc; p < &proc[NPROC]; p++) {
+    acquire(&p->lock);
+    if((p->state == RUNNABLE || p->state == RUNNING ||
+        p->state == SLEEPING) && p->queue_level > 0) {
+#ifdef MLFQ_DEBUG
+      printf("mlfq: promote pid %d from Q%d to Q0\n", p->pid, p->queue_level);
+#endif
+      p->queue_level = 0;
+      p->remaining_ticks = time_slice_for(0);
+    }
+    release(&p->lock);
+  }
+}
