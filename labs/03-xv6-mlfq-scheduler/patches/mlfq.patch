-        // before jumping back to us.
-        p->state = RUNNING;
-        c->proc = p;
-        swtch(&c->context, &p->context);
-
-        // Process is done running for now.
-        // It should have changed its p->state before coming back.
-        c->proc = 0;
-        found = 1;
+    for(int queue = 0; queue < MLFQ_LEVELS; queue++) {
+      acquire(&mlfq_lock);
+      int start_idx = (last_scheduled[queue] + 1) % NPROC;
+      release(&mlfq_lock);
+
+      for(int offset = 0; offset < NPROC; offset++) {
+        int idx = (start_idx + offset) % NPROC;
+        p = &proc[idx];
+
+        acquire(&p->lock);
+        if(p->state == RUNNABLE && p->queue_level == queue) {
+          acquire(&mlfq_lock);
+          last_scheduled[queue] = idx;
+          release(&mlfq_lock);
+#ifdef MLFQ_DEBUG
+          printf("mlfq: schedule pid %d from Q%d\n", p->pid, queue);
+#endif
+          p->state = RUNNING;
+          c->proc = p;
+          swtch(&c->context, &p->context);
+          c->proc = 0;
+          found = 1;
+          release(&p->lock);
+          goto next_round;
+        }
+        release(&p->lock);
       }
-      release(&p->lock);
     }
-    if(found == 0) {
