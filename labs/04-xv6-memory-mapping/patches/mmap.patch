+uint64
+sys_mmap(void)
+{
+  uint64 requested_addr;
+  int length;
+  int prot;
+  int flags;
+  int fd;
+  int offset;
+  struct file *file;
+  struct proc *p = myproc();
+
+  argaddr(0, &requested_addr);
+  argint(1, &length);
+  argint(2, &prot);
+  argint(3, &flags);
+  if(argfd(4, &fd, &file) < 0)
+    return -1;
+  argint(5, &offset);
+
+  if(requested_addr != 0 || length <= 0 || offset < 0 ||
+     offset % PGSIZE != 0)
+    return -1;
+  if((prot & ~(PROT_READ | PROT_WRITE | PROT_EXEC)) != 0)
+    return -1;
+  if(flags != MAP_SHARED && flags != MAP_PRIVATE)
+    return -1;
+  if(file->type != FD_INODE || !file->readable)
+    return -1;
+  if((flags & MAP_SHARED) && (prot & PROT_WRITE) && !file->writable)
+    return -1;
+
+  struct vma *vma = 0;
+  for(int i = 0; i < NVMA; i++) {
+    if(!p->vmas[i].used) {
+      vma = &p->vmas[i];
+      break;
+    }
+  }
+  if(vma == 0)
+    return -1;
+
+  uint64 map_addr = PGROUNDUP(p->sz);
+  uint64 map_size = PGROUNDUP((uint64)length);
+  if(map_addr >= MAXVA || map_size > MAXVA - map_addr)
+    return -1;
+
+  vma->used = 1;
+  vma->addr = map_addr;
+  vma->length = length;
+  vma->prot = prot;
+  vma->flags = flags;
+  vma->file = filedup(file);
+  vma->offset = offset;
+  p->sz = map_addr + map_size;
+
+  return map_addr;
+}
+
+uint64
+sys_munmap(void)
+{
+  uint64 addr;
+  int length;
+  struct proc *p = myproc();
+
+  argaddr(0, &addr);
+  argint(1, &length);
+  if(length <= 0)
+    return -1;
+
+  for(int i = 0; i < NVMA; i++) {
+    struct vma *vma = &p->vmas[i];
+    if(vma->used && addr >= vma->addr && addr < vma->addr + vma->length)
+      return vma_unmap(p, vma, addr, length);
+  }
+
+  return -1;
+}
