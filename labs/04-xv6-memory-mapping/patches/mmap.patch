+static int
+writeback_vma(struct proc *p, struct vma *vma, uint64 addr, uint64 length)
+{
+  uint64 end = addr + length;
+  int result = 0;
+
+  if((vma->flags & MAP_SHARED) == 0 || (vma->prot & PROT_WRITE) == 0)
+    return 0;
+
+  for(uint64 va = addr; va < end; va += PGSIZE) {
+    pte_t *pte = walk(p->pagetable, va, 0);
+    if(pte == 0 || (*pte & PTE_V) == 0)
+      continue;
+
+    uint64 bytes = end - va;
+    if(bytes > PGSIZE)
+      bytes = PGSIZE;
+    uint64 file_offset = vma->offset + (va - vma->addr);
+
+    begin_op();
+    ilock(vma->file->ip);
+    int written = writei(vma->file->ip, 1, va, file_offset, bytes);
+    iunlock(vma->file->ip);
+    end_op();
+    if(written != (int)bytes)
+      result = -1;
+  }
+
+  return result;
+}
+
+// Unmap a complete VMA or a range at either edge of it.
+int
+vma_unmap(struct proc *p, struct vma *vma, uint64 addr, uint64 length)
+{
+  if(!vma->used || length == 0 || addr % PGSIZE != 0)
+    return -1;
+
+  uint64 vma_end = vma->addr + vma->length;
+  if(addr < vma->addr || addr >= vma_end || length > vma_end - addr)
+    return -1;
+
+  uint64 unmap_end = addr + length;
+  int at_start = addr == vma->addr;
+  int at_end = unmap_end == vma_end;
+  if(!at_start && !at_end)
+    return -1;
+  if(at_start && !at_end && length % PGSIZE != 0)
+    return -1;
+
+  int writeback_result = writeback_vma(p, vma, addr, length);
+  uvmunmap(p->pagetable, addr, PGROUNDUP(length) / PGSIZE, 1);
+
+  if(at_start && at_end) {
+    fileclose(vma->file);
+    memset(vma, 0, sizeof(*vma));
+  } else if(at_start) {
+    vma->addr += length;
+    vma->offset += length;
+    vma->length -= length;
+  } else {
+    vma->length = addr - vma->addr;
+  }
+
+  return writeback_result;
+}
