+static int
+handle_mmap_fault(struct proc *p, uint64 cause, uint64 fault_addr)
+{
+  struct vma *vma = 0;
+  for(int i = 0; i < NVMA; i++) {
+    if(p->vmas[i].used && fault_addr >= p->vmas[i].addr &&
+       fault_addr < p->vmas[i].addr + p->vmas[i].length) {
+      vma = &p->vmas[i];
+      break;
+    }
+  }
+  if(vma == 0)
+    return -1;
+
+  if((cause == 12 && (vma->prot & PROT_EXEC) == 0) ||
+     (cause == 13 && (vma->prot & PROT_READ) == 0) ||
+     (cause == 15 && (vma->prot & PROT_WRITE) == 0))
+    return -1;
+
+  uint64 page_addr = PGROUNDDOWN(fault_addr);
+  pte_t *existing = walk(p->pagetable, page_addr, 0);
+  if(existing != 0 && (*existing & PTE_V))
+    return -1;
+
+  char *memory = kalloc();
+  if(memory == 0)
+    return -1;
+  memset(memory, 0, PGSIZE);
+
+  uint64 page_offset = page_addr - vma->addr;
+  uint64 bytes_to_read = vma->length - page_offset;
+  if(bytes_to_read > PGSIZE)
+    bytes_to_read = PGSIZE;
+
+  ilock(vma->file->ip);
+  int bytes_read = readi(vma->file->ip, 0, (uint64)memory,
+                         vma->offset + page_offset, bytes_to_read);
+  iunlock(vma->file->ip);
+  if(bytes_read < 0) {
+    kfree(memory);
+    return -1;
+  }
+
+  int permissions = PTE_U;
+  if(vma->prot & (PROT_READ | PROT_WRITE))
+    permissions |= PTE_R;
+  if(vma->prot & PROT_WRITE)
+    permissions |= PTE_W;
+  if(vma->prot & PROT_EXEC)
+    permissions |= PTE_X;
+
+  if(mappages(p->pagetable, page_addr, PGSIZE,
+              (uint64)memory, permissions) < 0) {
+    kfree(memory);
+    return -1;
+  }
+
+  return 0;
+}
